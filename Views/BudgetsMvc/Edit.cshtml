@model BudgetApp.Dtos.CreateBudgetDto

@{
    ViewData["Title"] = "Edit Budget";
    var budgetId = ViewBag.BudgetId;
    var userId = ViewBag.UserId;
}

<div class="admin-header">
    <h1>Edit Budget</h1>
</div>

<form asp-action="Edit" asp-route-id="@budgetId" method="post" class="admin-form">
    <input type="hidden" asp-for="UserId" />
    <div class="form-group">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-input" />
    </div>
    <div class="form-group">
        <label asp-for="StartDate">Start Date</label>
        <input asp-for="StartDate" type="date" class="form-input" />
    </div>
    <div class="form-group">
        <label asp-for="EndDate">End Date</label>
        <input asp-for="EndDate" type="date" class="form-input" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Save</button>
        <a asp-action="Index" class="btn-cancel">Cancel</a>
    </div>
</form>