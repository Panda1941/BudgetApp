@model BudgetApp.Dtos.CreateBudgetDto

@{
    ViewData["Title"] = "Create Budget";
    var userId = ViewBag.UserId;
}

<div class="admin-header">
    <h1>Create Budget</h1>
</div>

<form asp-action="Create" method="post" class="admin-form">
    <input type="hidden" asp-for="UserId" />
    <div class="form-group">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-input" placeholder="e.g., Monthly Budget 2026" />
    </div>
    <div class="form-group">
        <label asp-for="StartDate">Start Date</label>
        <input asp-for="StartDate" type="date" class="form-input" />
    </div>
    <div class="form-group">
        <label asp-for="EndDate">End Date</label>
        <input asp-for="EndDate" type="date" class="form-input" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Create Budget</button>
        <a asp-action="Index" asp-route-userId="@userId" class="btn-cancel">Cancel</a>
    </div>
</form>