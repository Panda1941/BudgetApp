@model BudgetApp.Dtos.CreateFinancialEventDto

@{
    ViewData["Title"] = "Add Transaction";
    var account = ViewBag.Account as BudgetApp.Dtos.AccountResponseDto;
    var categories = ViewBag.Categories as List<BudgetApp.Dtos.CategoryResponseDto>;
    var otherAccounts = ViewBag.OtherAccounts as List<BudgetApp.Dtos.AccountResponseDto>;
    var userId = ViewBag.UserId;
}

<div class="admin-header">
    <h1>Add Transaction to @account.Name</h1>
</div>

<form asp-action="AddTransaction" asp-route-accountId="@account.Id" method="post" class="admin-form">
    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="DestinationAccountId" />
    
    <div class="form-group">
        <label asp-for="Description">Description</label>
        <input asp-for="Description" class="form-input" placeholder="e.g., Groceries, Salary, Rent" />
    </div>
    
    <div class="form-group">
        <label asp-for="Amount">Amount</label>
        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-input" placeholder="100.00" />
    </div>
    
    <div class="form-group">
        <label asp-for="Date">Date</label>
        <input asp-for="Date" type="date" class="form-input" />
    </div>
    
    <div class="form-group">
        <label asp-for="Type">Type</label>
        <select asp-for="Type" class="form-input" id="type-select" onchange="toggleFields()">
            <option value="Income">Income</option>
            <option value="Expense">Expense</option>
            <option value="Transfer">Transfer</option>
        </select>
    </div>
    
    <div class="form-group" id="category-field">
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" class="form-input">
            <option value="">Select category</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
    </div>
    
    <div class="form-group" id="transfer-field" style="display: none;">
        <label asp-for="DestinationAccountId">Destination Account</label>
        <select asp-for="DestinationAccountId" class="form-input">
            <option value="">Select destination account</option>
            @foreach (var acc in otherAccounts)
            {
                <option value="@acc.Id">@acc.Name (@acc.Balance.ToString("C"))</option>
            }
        </select>
    </div>
    
    <div class="form-actions">
        <button type="submit" class="btn-primary">Add Transaction</button>
        <a asp-action="Detail" asp-route-id="@account.Id" class="btn-cancel">Cancel</a>
    </div>
</form>

<script>
    function toggleFields() {
        var type = document.getElementById('type-select').value;
        var categoryField = document.getElementById('category-field');
        var transferField = document.getElementById('transfer-field');
        
        if (type === 'Transfer') {
            categoryField.style.display = 'none';
            transferField.style.display = 'block';
        } else {
            categoryField.style.display = 'block';
            transferField.style.display = 'none';
        }
    }
    
    // Initialize on page load
    toggleFields();
</script>