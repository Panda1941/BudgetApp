@model List<BudgetApp.Dtos.AccountResponseDto>

@{
    ViewData["Title"] = "Accounts";
    var userId = ViewBag.UserId;
}

<div class="admin-header">
    <h1>Accounts</h1>
    <p>@Model.Count account(s) — <a asp-action="Create" asp-route-userId="@userId" class="btn-primary" style="font-size: 0.85rem; padding: 4px 10px;">Add Account</a></p>
</div>

@if (Model.Count == 0)
{
    <p class="empty-state">No accounts yet. Create your first account to get started.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Balance</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in Model)
            {
                <tr>
                    <td>@account.Id</td>
                    <td>@account.Name</td>
                    <td>@account.Balance.ToString("C")</td>
                    <td class="actions">
                        <a asp-action="Detail" asp-route-id="@account.Id" class="btn-edit">Detail</a>
                        <a asp-action="Edit" asp-route-id="@account.Id" class="btn-edit">Edit</a>
                        <form asp-action="Delete" asp-route-id="@account.Id" method="post"
                              onsubmit="return confirm('Delete this account? This cannot be undone.');"
                              style="display:inline;">
                            <button type="submit" class="btn-delete">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}