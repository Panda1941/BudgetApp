@model BudgetApp.Dtos.CreateUserDto

@{
    ViewData["Title"] = "Edit User";
}

<div class="admin-header">
    <h1>Edit User</h1>
</div>

<form asp-action="EditUser" asp-route-id="@ViewBag.UserId" method="post" class="admin-form">
    <div class="form-group">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" class="form-input" />
    </div>
    <div class="form-group">
        <label asp-for="Password">New Password</label>
        <input asp-for="Password" type="password" class="form-input" placeholder="Leave blank to keep current password" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Save</button>
        <a asp-action="Users" class="btn-cancel">Cancel</a>
    </div>
</form>
